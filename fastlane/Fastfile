default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Ensure web assets are built and Capacitor iOS files are copied before running fastlane.
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      output_directory: "fastlane/build"
    )
    upload_to_testflight(skip_waiting_for_build_processing: false)
  end

  desc "Build and deliver to App Store (release)"
  lane :release do
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true
    )
    deliver(force: true)
  end
end
